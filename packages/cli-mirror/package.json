{
    "name": "@augmentd-labs/canvas-cli-mirror",
    "version": "0.2.0",
    "description": "Canvas CLI package: `canvas remote mirror` — workspace mirrors on this device (canvas-edge / canvas-fuse), first-run wizard, pm2 supervision",
    "license": "AGPL-3.0-or-later",
    "type": "module",
    "exports": {
        ".": "./src/index.js"
    },
    "files": [
        "src",
        "NOTICE"
    ],
    "canvasCli": {
        "package": "mirror",
        "mount": "remote",
        "size": "~1 MB (+ canvas-edge runtime on first mirror)"
    },
    "scripts": {
        "test": "node --test \"tests/**/*.test.js\"",
        "lint": "eslint src tests --no-error-on-unmatched-pattern"
    },
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "@augmentd-labs/canvas-cli-host": "workspace:*"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canvas-ui/canvas.git",
        "directory": "packages/cli-mirror"
    }
}
